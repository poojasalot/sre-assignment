POSTGRES_DB=tokendb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-only
REDIS_PASSWORD=change-me-local-only
TOKEN_TTL_SECONDS=3600
DB_POOL_MIN=1
DB_POOL_MAX=10
GRPC_TIMEOUT_SECONDS=3
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
DEPLOYMENT_ENVIRONMENT=local
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local-only

# Optional application-managed gRPC mTLS (leave all three client values unset for local plaintext demo)
# GRPC_TLS_CA_CERT=/run/tls/ca.crt
# GRPC_TLS_CLIENT_CERT=/run/tls/tls.crt
# GRPC_TLS_CLIENT_KEY=/run/tls/tls.key
# GRPC_TLS_SERVER_NAME=go-service
