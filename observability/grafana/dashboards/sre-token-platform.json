{
  "id": null,
  "uid": "sre-token-platform",
  "title": "SRE - Token Platform Health",
  "tags": [
    "sre",
    "token-platform",
    "red"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Python API request rate",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (route) (rate(http_server_requests_total{job=\"python-token-service\"}[5m]))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Python API 5xx ratio",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_total{job=\"python-token-service\",status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_total{job=\"python-token-service\"}[5m])), 0.001)",
          "legendFormat": "5xx ratio",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Python API p50 / p95 latency",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"python-token-service\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"python-token-service\"}[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "title": "Go gRPC request rate by method",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (method, status) (rate(grpc_server_requests_total{job=\"go-token-service\"}[5m]))",
          "legendFormat": "{{method}} / {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "PostgreSQL connection pool utilisation",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "targets": [
        {
          "expr": "db_pool_connections_in_use / clamp_min(db_pool_connections_max, 1)",
          "legendFormat": "pool utilisation",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Redis p95 command latency",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(redis_operation_duration_seconds_bucket{job=\"go-token-service\"}[5m])))",
          "legendFormat": "{{operation}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Token mint outcomes",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(tokens_minted_total{job=\"go-token-service\"}[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Redis key count (all keys in DB 0)",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "expr": "redis_db_keys{job=\"go-token-service\"}",
          "legendFormat": "keys",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "DB query errors",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 24,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "expr": "rate(db_query_errors_total{job=\"python-token-service\"}[5m])",
          "legendFormat": "errors/sec",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Python pool acquire p95",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 24,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(db_pool_acquire_duration_seconds_bucket{job=\"python-token-service\"}[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Python gRPC client calls to Go service",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(grpc_client_requests_total{job=\"python-token-service\"}[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "Redis connection pool",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "redis_pool_total_connections{job=\"go-token-service\"}",
          "legendFormat": "total",
          "refId": "A"
        },
        {
          "expr": "redis_pool_idle_connections{job=\"go-token-service\"}",
          "legendFormat": "idle",
          "refId": "B"
        }
      ]
    },
    {
      "id": 13,
      "title": "Redis pool acquisition timeouts",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "increase(redis_pool_timeouts_total{job=\"go-token-service\"}[5m])",
          "legendFormat": "timeouts / 5m",
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "title": "SLIs and Go gRPC RED",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 15,
      "title": "Availability SLI (1h, target 99.9%)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "1 - job:http_server_error_ratio:rate1h{job=\"python-token-service\"}",
          "legendFormat": "python API",
          "refId": "A"
        },
        {
          "expr": "1 - job:grpc_server_error_ratio:rate1h{job=\"go-token-service\"}",
          "legendFormat": "go MintToken",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 16,
      "title": "Go gRPC server error ratio",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 42,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "job:grpc_server_error_ratio:rate5m{job=\"go-token-service\"}",
          "legendFormat": "server failures",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 17,
      "title": "Go gRPC p50 / p95 latency",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 42,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(grpc_server_request_duration_seconds_bucket{job=\"go-token-service\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(grpc_server_request_duration_seconds_bucket{job=\"go-token-service\"}[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 18,
      "title": "Audit queue (Redis Stream token:events)",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 50,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 19,
      "title": "Queue depth (undelivered + unacknowledged)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 51,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "max(redis_stream_lag_messages{job=\"go-token-service\"})",
          "legendFormat": "lag (not yet delivered)",
          "refId": "A"
        },
        {
          "expr": "max(redis_stream_pending_messages{job=\"go-token-service\"})",
          "legendFormat": "pending (not yet acked)",
          "refId": "B"
        }
      ]
    },
    {
      "id": 20,
      "title": "Message processing duration p95",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 51,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(queue_message_processing_duration_seconds_bucket{job=\"go-token-service\"}[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 21,
      "title": "Throughput and oldest pending age",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 51,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(queue_messages_processed_total{job=\"go-token-service\"}[5m]))",
          "legendFormat": "processed {{status}}/s",
          "refId": "A"
        },
        {
          "expr": "max(redis_stream_oldest_pending_age_seconds{job=\"go-token-service\"})",
          "legendFormat": "oldest pending (s)",
          "refId": "B"
        }
      ]
    },
    {
      "id": 22,
      "title": "Redis server (redis_exporter)",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 59,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 23,
      "title": "Redis instances up / role",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 60,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "redis_up{job=\"redis-exporter\"}",
          "legendFormat": "up {{pod}}",
          "refId": "A"
        },
        {
          "expr": "redis_instance_info{job=\"redis-exporter\",role=\"master\"}",
          "legendFormat": "primary {{pod}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 24,
      "title": "Redis connected clients / replicas",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 60,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (pod) (redis_connected_clients{job=\"redis-exporter\"})",
          "legendFormat": "clients {{pod}}",
          "refId": "A"
        },
        {
          "expr": "max(redis_connected_slaves{job=\"redis-exporter\"})",
          "legendFormat": "replicas on primary",
          "refId": "B"
        }
      ]
    }
  ],
