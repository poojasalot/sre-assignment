{
  "id": null,
  "uid": "sre-token-platform",
  "title": "SRE - Token Platform Health",
  "tags": [
    "sre",
    "token-platform",
    "red"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Python API request rate",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (route) (rate(http_server_requests_total{job=\"python-token-service\"}[5m]))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Python API 5xx ratio",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_total{job=\"python-token-service\",status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_total{job=\"python-token-service\"}[5m])), 0.001)",
          "legendFormat": "5xx ratio",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Python API p50 / p95 latency",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"python-token-service\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"python-token-service\"}[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "title": "Go gRPC request rate by method",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (method, status) (rate(grpc_server_requests_total{job=\"go-token-service\"}[5m]))",
          "legendFormat": "{{method}} / {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "PostgreSQL connection pool utilisation",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "targets": [
        {
          "expr": "db_pool_connections_in_use / clamp_min(db_pool_connections_max, 1)",
          "legendFormat": "pool utilisation",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Redis p95 command latency",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(redis_operation_duration_seconds_bucket{job=\"go-token-service\"}[5m])))",
          "legendFormat": "{{operation}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Token mint outcomes",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(tokens_minted_total{job=\"go-token-service\"}[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Redis key count (all keys in DB 0)",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "expr": "redis_db_keys{job=\"go-token-service\"}",
          "legendFormat": "keys",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "DB query errors",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 24,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "expr": "rate(db_query_errors_total{job=\"python-token-service\"}[5m])",
          "legendFormat": "errors/sec",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Python pool acquire p95",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 24,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(db_pool_acquire_duration_seconds_bucket{job=\"python-token-service\"}[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Python gRPC client calls to Go service",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(grpc_client_requests_total{job=\"python-token-service\"}[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "Redis connection pool",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "redis_pool_total_connections{job=\"go-token-service\"}",
          "legendFormat": "total",
          "refId": "A"
        },
        {
          "expr": "redis_pool_idle_connections{job=\"go-token-service\"}",
          "legendFormat": "idle",
          "refId": "B"
        }
      ]
    },
    {
      "id": 13,
      "title": "Redis pool acquisition timeouts",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "increase(redis_pool_timeouts_total{job=\"go-token-service\"}[5m])",
          "legendFormat": "timeouts / 5m",
          "refId": "A"
        }
      ]
    }
  ]
}
